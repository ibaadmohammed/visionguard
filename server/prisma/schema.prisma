generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model datasets {
  id                BigInt           @id @default(autoincrement())
  project_id        BigInt
  name              String           @db.VarChar(150)
  description       String?
  image_count       Int              @default(0)
  annotation_format String?          @db.VarChar(30)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  projects          projects         @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploaded_files    uploaded_files[]

  @@index([project_id], map: "idx_datasets_project_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model detection_results {
  id                 BigInt             @id @default(autoincrement())
  session_id         BigInt
  class_name         String             @db.VarChar(120)
  confidence         Decimal            @db.Decimal(7, 6)
  x_min              Decimal?           @db.Decimal(12, 4)
  y_min              Decimal?           @db.Decimal(12, 4)
  x_max              Decimal?           @db.Decimal(12, 4)
  y_max              Decimal?           @db.Decimal(12, 4)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  detection_sessions detection_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_results_session_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model detection_sessions {
  id                BigInt              @id @default(autoincrement())
  project_id        BigInt?
  user_id           BigInt
  model_name        String              @db.VarChar(100)
  detection_type    String              @db.VarChar(30)
  total_detections  Int                 @default(0)
  inference_time_ms Decimal?            @db.Decimal(12, 3)
  average_fps       Decimal?            @db.Decimal(10, 2)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  detection_results detection_results[]
  projects          projects?           @relation(fields: [project_id], references: [id], onUpdate: NoAction)
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_sessions_created_at")
  @@index([project_id], map: "idx_sessions_project_id")
  @@index([user_id], map: "idx_sessions_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model projects {
  id                 BigInt               @id @default(autoincrement())
  user_id            BigInt
  name               String               @db.VarChar(150)
  description        String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  datasets           datasets[]
  detection_sessions detection_sessions[]
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploaded_files     uploaded_files[]

  @@index([user_id], map: "idx_projects_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model schema_migrations {
  version     Int      @id
  description String
  applied_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model uploaded_files {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt
  project_id    BigInt?
  dataset_id    BigInt?
  original_name String    @db.VarChar(255)
  stored_name   String    @db.VarChar(255)
  mime_type     String    @db.VarChar(100)
  size_bytes    BigInt
  storage_path  String
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  datasets      datasets? @relation(fields: [dataset_id], references: [id], onUpdate: NoAction)
  projects      projects? @relation(fields: [project_id], references: [id], onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dataset_id], map: "idx_uploaded_files_dataset_id")
  @@index([project_id], map: "idx_uploaded_files_project_id")
  @@index([user_id], map: "idx_uploaded_files_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                 BigInt               @id @default(autoincrement())
  full_name          String               @db.VarChar(120)
  email              String               @unique @db.VarChar(255)
  password_hash      String
  role               String               @default("user") @db.VarChar(20)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  detection_sessions detection_sessions[]
  projects           projects[]
  uploaded_files     uploaded_files[]

  @@index([email], map: "idx_users_email")
}
