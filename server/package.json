{
  "name": "visionguard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
  "dev": "nodemon src/server.js",
  "build": "prisma generate",
  "start": "node src/server.js",
  "check": "node --check src/server.js && node --check src/app.js && node --check src/config/prisma.js && node --check src/config/supabase.js && node --check src/routes/health.routes.js && node --check src/middleware/errorHandler.js"
},
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
